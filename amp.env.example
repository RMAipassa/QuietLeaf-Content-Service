# Copy this file to .env and replace the empty token before starting the instance.
QUIETLEAF_API_TOKEN=
PORT=8765
QUIETLEAF_ARCHIVE_MAX_BYTES=2147483648
QUIETLEAF_FOLLOW_INTERVAL_SECONDS=3600
QUIETLEAF_ACTIVE_INTERVAL_SECONDS=1800

# NovelPing remains opt-in. Authorized mode requires explicit permission for automation.
QUIETLEAF_ENABLE_NOVELPING=0
QUIETLEAF_NOVELPING_ACCESS_AUTHORIZED=0
QUIETLEAF_NOVELPING_BASE_URL=https://novelping.com
QUIETLEAF_NOVELPING_SEARCH_PATH='/search?keyword={query}'
QUIETLEAF_NOVELPING_IMAGE_HOSTS=images.novelping.com
